# Toolbox Vault Website — environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every secret/value the stack needs is documented here; nothing is hard-coded.

# --- Domains (rendered into nginx; TLS terminates at Cloudflare) ---
APP_DOMAIN=
FILES_DOMAIN=

# --- PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# SQLAlchemy connection URL built from the above (override if needed).
DATABASE_URL=

# --- Stripe payments (backend docker service only) ---
# DARK BY DEFAULT: with STRIPE_SECRET_KEY empty, nothing is
# chargeable — checkout/portal answer 503
# {code: payments_not_configured} and the webhook route 404s.
# Price ids are NOT env: they are operator settings in
# Admin -> Settings (per plan/period + Business brackets + AI
# credit packs), so pricing changes never need a deploy. In
# production these values are synced from GitHub repo secrets of
# the same names by the deploy workflow — leave blank here. The
# owner's Stripe account doesn't exist yet; when it does, start
# with TEST keys (sk_test_... / pk_test_... / whsec_...) and swap
# to live keys only after a full test-mode checkout round.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Object storage (SeaweedFS, S3-compatible; MINIO_* names are legacy) ---
# Root credentials: used ONLY by the one-shot storage-config/storage-init
# jobs to provision the bucket and the app user below. The API never
# sees them.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# App credentials: provisioned by storage-config, object-level access
# only. These are what the API connects with.
MINIO_APP_USER=
MINIO_APP_PASSWORD=
MINIO_ENDPOINT=
MINIO_BUCKET=
# URL the browser uses for presigned file links. Empty = MINIO_ENDPOINT.
# In production this is the files subdomain served through the nginx proxy
# (path is forwarded unchanged so S3 signatures stay valid).
S3_PUBLIC_ENDPOINT=

# --- API ---
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=
# Public origin of the website; used to build links in emails.
APP_BASE_URL=

# --- Social login (OAuth) — optional ---
# Leave a provider's values blank to disable it entirely: its
# "Continue with ..." button disappears and its endpoints return 404.
# Register the callbacks https://toolboxvault.com/api/core/auth/google/callback
# and https://toolboxvault.com/api/core/auth/facebook/callback with the
# provider. In production these are synced into the server .env from
# GitHub secrets by the deploy workflow — never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Transactional email (Resend seam) ---
# EMAIL_PROVIDER=dev logs instead of sending (and records the
# email_outbox rows) — the pre-launch default. Set EMAIL_PROVIDER=
# resend with a key to go live. Synced from GitHub secrets in
# production like the OAuth values above.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=

# --- Disaster Vault (platform backups) ---
# All optional and fail-safe: with none of these set, the backup
# service still builds a nightly bundle but keeps it on the
# server, unencrypted and never uploaded (Admin -> Settings shows
# runs marked encryption_not_configured). In production these are
# synced into the server .env from GitHub secrets by the deploy
# workflow — never commit real values.
# age recipient (PUBLIC) key bundles are encrypted to. The private
# key never lives on the server (owner + Secure Vault only).
BACKUP_AGE_PUBLIC_KEY=
# Google Drive upload leg: service-account JSON key, base64'd,
# and the id of the "Toolbox Vault Backups" Drive folder shared
# with that service account. Both required for uploads.
BACKUP_SA_KEY_B64=
BACKUP_DRIVE_FOLDER_ID=
# Where the weekly digest + failure alerts are emailed.
BACKUP_REPORT_EMAIL=
# Nightly bundle time (UTC) and rolling retention.
BACKUP_TIME_UTC=

# --- Frontend (build-time) ---
# Where the browser reaches the API. In docker compose, nginx proxies /api.
VITE_API_URL=
